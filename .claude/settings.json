{
  "permissions": {
    "deny": [
      "Edit(//**/.git/**)",
      "Edit(//**/.git)",
      "Artifact",
      "ShowOnboardingRolePicker",
      "SuggestPluginInstall",
      "SuggestSkills",
      "SearchPlugins",
      "Workflow",
      "ScheduleWakeup",
      "mcp__Claude_Docs",
      "mcp__claude-code-remote__create_environment",
      "mcp__claude-code-remote__update_environment",
      "mcp__claude-code-remote__switch_environment",
      "mcp__claude-code-remote__get_environment",
      "mcp__claude-code-remote__request_credential",
      "mcp__claude-code-remote__request_computer_folder",
      "mcp__claude-code-remote__list_computer_folders",
      "mcp__claude-code-remote__confirm_repository_trust",
      "mcp__claude-code-remote__watch_url",
      "mcp__claude-code-remote__unwatch_url",
      "mcp__claude-code-remote__unarchive_session",
      "mcp__claude-code-remote__set_session_tags",
      "mcp__claude-code-remote__set_session_title"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=$(git -C \"${CLAUDE_PROJECT_DIR:-.}\" --no-replace-objects show refs/remotes/origin/main:scripts/work-saved.sh 2>/dev/null) || { echo \"Not run: the work-saved hook runs only its copy merged into main, and refs/remotes/origin/main has none. Fetch main (git fetch origin main), and it runs from the next reply on.\"; exit 0; }; bash -c \"$f\" work-saved start'",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=$(git -C \"${CLAUDE_PROJECT_DIR:-.}\" --no-replace-objects show refs/remotes/origin/main:scripts/helper-call.mjs 2>/dev/null) || exit 0; node --input-type=module -e \"$f\"'",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=$(git -C \"${CLAUDE_PROJECT_DIR:-.}\" --no-replace-objects show refs/remotes/origin/main:scripts/work-saved.sh 2>/dev/null) || exit 0; bash -c \"$f\" work-saved stop'",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
