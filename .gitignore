# The packages of other publishers the core's scripts run, installed from package-lock.json by scripts/install.mjs:
# never tracked, here or in a project's copy, where this file stands at the copy's root (#654). The copy's package
# list, lock file and .npmrc are tracked there even where the project's own .gitignore leaves such files out.
/node_modules/
!/.npmrc
!/package.json
!/package-lock.json
